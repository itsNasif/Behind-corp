# Generate .env.local with npm run local:setup. Never reuse generated local secrets.
# Production and staging require all fields below, with real HTTPS origins.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/behind
OIDC_CLIENT_ID=behind-web
OIDC_CLIENT_SECRET=
# Runtime role only, via Supabase transaction pooler (port 6543); sslmode=require.
DATABASE_URL=
# Privileged direct connection ONLY on the operator machine, never on Vercel.
MIGRATION_DATABASE_URL=
# Used by the local migration script to create the runtime role; local only.
RUNTIME_DB_PASSWORD=
# Production Upstash. Disable analytics; no local/in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local Redis only (generated).
REDIS_URL=
RATE_LIMIT_SALT=
# Only the site key is public. Production must use real keys, exact origin hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=localhost
# Staging HTTP Basic password, >=32 chars; username preview.
# Also enable Vercel Deployment Protection for all deployment aliases.
PREVIEW_ACCESS_SECRET=
# Identity container secrets: configure on its host, NOT in the website deployment.
KC_DB_URL=
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_HOSTNAME=
KC_HOSTNAME_ADMIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Operator jobs only: protected administrative origin, short-lived token and immutable subject.
KEYCLOAK_ADMIN_ORIGIN=
KEYCLOAK_ADMIN_TOKEN=
ADMIN_SUBJECT=
